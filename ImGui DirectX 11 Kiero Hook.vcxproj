      <!-- /SECTION:.text,RE forces .text to Read+Execute only (no Write).
           Defensive complement to tools/compute_text_crc.ps1: discourages
           the linker from emitting writable relocations into .text that
           the loader would patch at load-time (which would diverge on-disk
           CRC from in-memory CRC). NOT a guarantee on x64 — RIP-relative
           static initializers can still trigger loader fixups. The mapped-
           image CRC script remains the always-correct path. -->
      <AdditionalOptions>/FORCE:MULTIPLE /IGNORE:4006 /SECTION:.text,RE %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <PostBuildEvent>
      <!-- v2: manifest is NO LONGER copied next to ZwSpark.dll. The DLL
           fetches the sealed manifest from the worker `/manifest` endpoint
           which serves it out of Cloudflare KV (key: manifest:<game_sha>).
           CI publishes the sealed bytes to KV via
           `pwsh tools/upload_manifest_to_kv.ps1` — see
           tools/prompts/manifest_release_workflow.md.
           Customer machines must never see cheat_manifest.{json,sealed}. -->
      <Command>if not exist "$(OutDir)ui\assets" mkdir "$(OutDir)ui\assets"
xcopy /Y /Q "$(ProjectDir)ui\assets\*.ttf" "$(OutDir)ui\assets\"</Command>
      <Message>Bundling ui/assets/*.ttf next to ZwSpark.dll (manifest now served via worker /manifest)</Message>
    </PostBuildEvent>
